digraph SystemArchitecture {
    // Graph settings
    rankdir=TB;
    node [shape=box, style=filled, fontsize=12, fontname="Arial", width=1.5];
    edge [fontsize=10, fontname="Arial"];

    // Top rank: Main Process components
    Frontend [label="Frontend\nNext.js Interface", fillcolor=lightgreen];
    Backend [label="Backend\nNode.js Server", fillcolor=lightgreen];
    Database [label="Database\nMongoDB", fillcolor=lightyellow];
    AIServices [label="AI Processing\nGroq + HuggingFace", fillcolor=lightcoral];

    // Bottom rank: Input, Output, and External APIs
    UserInput [label="INPUT\nUser Requests\n• Subject\n• PDF Uploads\n• Resource Search", fillcolor=lightblue, shape=note];
    ExternalAPIs [label="External APIs\nTavily Search", fillcolor=lightsalmon];
    Results [label="OUTPUT\nSystem Results\n• Study Plans\n• PDF Analysis\n• Curated Resources", fillcolor=lightblue, shape=note];

    // Data Flow
    UserInput -> Frontend [label="User Interaction"];
    Frontend -> Backend [label="HTTP Requests"];
    Backend -> Database [label="Data Storage"];
    Backend -> AIServices [label="Send to AI", constraint=false];
    AIServices -> ExternalAPIs [label="API Calls"];
    ExternalAPIs -> AIServices [label="API Response"];
    AIServices -> Backend [label="AI Results", constraint=false];
    Backend -> Frontend [label="Return Data"];
    Frontend -> Results [label="Final Output"];

    // Explicit ranking constraints
    {rank=min; Frontend; Backend; Database; }
    {rank=max; UserInput; ExternalAPIs; Results; AIServices;}
}
